# Ham Ops Console service (systemd unit).
# Installed to /etc/systemd/system/hamops-console.service; see pi/README.md.
# Assumes the repository is cloned to /home/hamops/hamops-console on the Pi.

[Unit]
Description=Ham Ops Console service (dashboard page and JSON API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hamops
WorkingDirectory=/home/hamops/hamops-console/server
ExecStart=/usr/bin/python3 -m hamops_console
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
